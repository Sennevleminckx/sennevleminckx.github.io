<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" class="in-text" version="1.0" default-locale="en-GB">
  <info>
    <title>Reverse chronological (sennevleminckx.be)</title>
    <id>https://sennevleminckx.be/reverse-chron</id>
    <link href="https://sennevleminckx.be/reverse-chron" rel="self"/>
    <author><name>Senne Vleminckx</name></author>
    <category citation-format="author-date"/>
    <updated>2026-01-01T00:00:00+00:00</updated>
  </info>
  <macro name="author">
    <names variable="author">
      <name and="text" initialize-with=". " name-as-sort-order="all" delimiter=", "/>
    </names>
  </macro>
  <macro name="year">
    <date variable="issued"><date-part name="year"/></date>
  </macro>
  <citation>
    <layout><text macro="year"/></layout>
  </citation>
  <bibliography entry-spacing="1" line-spacing="1">
    <sort>
      <key variable="issued" sort="descending"/>
      <key macro="author"/>
    </sort>
    <layout suffix=".">
      <group delimiter=". ">
        <text macro="author"/>
        <text macro="year" prefix="(" suffix=")"/>
        <text variable="title"/>
        <group delimiter=", ">
          <text variable="container-title" font-style="italic"/>
          <text variable="publisher"/>
          <text variable="genre"/>
          <group delimiter=", ">
            <group delimiter=":"><text variable="volume"/><text variable="issue"/></group>
            <text variable="page"/>
          </group>
        </group>
      </group>
      <text variable="DOI" prefix=" https://doi.org/"/>
    </layout>
  </bibliography>
</style>
